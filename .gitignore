# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
dist/
*.tsbuildinfo

# Go
/bin/
*.exe

# Local environment
.env
.env.local

# Generated on every build from committed sources (each package's `gen` script)
packages/*/src/generated/
# But @household/sync's client registry, which `pnpm run gen` writes from the migrated schema and
# commits, since no build has the database to write it (ADR 0019)
!packages/sync/src/generated/

# Turborepo and test output
.turbo/
coverage/

# Expo: its cache, and the native projects a prebuild generates from app.config.ts, which are
# never committed (the app is built from its configuration, PL-5)
.expo/
apps/mobile/android/
apps/mobile/ios/

# What a native build makes, and what signs or configures one: none of it belongs in a history
# that gitleaks reads whole
*.apk
*.aab
*.ipa
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
google-services.json
GoogleService-Info.plist
