# Copy to `.env` to change a default; docker compose reads `.env` from the repository
# root. Nothing here is a secret: these are local-development values only, and every
# port is published on 127.0.0.1.

# Host ports for the services in docker-compose.yml.
HOUSEHOLD_PG_PORT=5432
HOUSEHOLD_S3_PORT=9000
HOUSEHOLD_S3_CONSOLE_PORT=9001
HOUSEHOLD_CONVERTER_PORT=3100
HOUSEHOLD_STRIPE_MOCK_PORT=12111
HOUSEHOLD_SMTP_PORT=1025
HOUSEHOLD_MAIL_UI_PORT=8025
HOUSEHOLD_POWERSYNC_PORT=8081

# Where the Go tests reach PostgreSQL. This default matches the compose service above.
# Go does not read `.env`: when you change HOUSEHOLD_PG_PORT, export this variable in
# your shell with the same port. CI sets it for its own service container. The tests log
# in as the three roles below with the passwords shown, and set those passwords.
HOUSEHOLD_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/household?sslmode=disable

# The server (server/cmd/household-api), which also does not read `.env`. With
# HOUSEHOLD_ENV=development, the default, every value below is already the default, so
# `pnpm run db:setup` and `pnpm run dev:api` need nothing set. In staging and production no
# connection string is defaulted, and each command refuses to start without those it uses;
# the other settings keep the defaults shown, but for HOUSEHOLD_HTTP_ADDR, which is :8080.
HOUSEHOLD_ENV=development
HOUSEHOLD_HTTP_ADDR=127.0.0.1:8080
HOUSEHOLD_LOG_LEVEL=info
HOUSEHOLD_SHUTDOWN_TIMEOUT=20s
HOUSEHOLD_MAX_BODY_BYTES=1048576
HOUSEHOLD_BODY_TIMEOUT=60s

# One connection string per database role (PRD 01 §2.3), each logging in as its role.
# `serve` uses the first, `migrate` the second; `bootstrap` sets each role's password to
# the one its string carries, and connects as the administrator to do it. The meter role's
# and the staff role's are `serve`'s too: the first counts across households, the second reads
# the metadata the platform staff API answers with, and neither reads what a household wrote.
HOUSEHOLD_DATABASE_URL=postgres://household_app:household_app@127.0.0.1:5432/household?sslmode=disable
HOUSEHOLD_MIGRATE_DATABASE_URL=postgres://household_migrate:household_migrate@127.0.0.1:5432/household?sslmode=disable
HOUSEHOLD_METER_DATABASE_URL=postgres://household_meter:household_meter@127.0.0.1:5432/household?sslmode=disable
HOUSEHOLD_STAFF_DATABASE_URL=postgres://household_staff:household_staff@127.0.0.1:5432/household?sslmode=disable
HOUSEHOLD_ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/household?sslmode=disable

# What `serve` needs for the accounts (item 8). Outside development the web URL, the trusted
# proxies, the mail server, its sender and the breached-password corpus must each be set.
#   HOUSEHOLD_WEB_URL          where the web client is served, over https outside development:
#                              the emails link to it, and its origin may send unsafe requests.
#   HOUSEHOLD_ALLOWED_ORIGINS  further origins that may, comma-separated.
#   HOUSEHOLD_TRUSTED_PROXIES  proxies, as addresses or CIDR prefixes, whose X-Forwarded-For names
#                              the client, or `none` where clients reach the server directly, the
#                              development default. Behind a load balancer left unnamed, every
#                              client would share the balancer's sign-in and registration limits.
#   HOUSEHOLD_SMTP_URL         smtp://user:password@host:587 (STARTTLS required off this machine)
#                              or smtps://…:465. The default is the compose mail catcher, whose
#                              inbox is at http://127.0.0.1:8025. When you change
#                              HOUSEHOLD_SMTP_PORT, export this with the same port: the server
#                              does not read `.env`.
#   HOUSEHOLD_BREACH_CORPUS    the breached-password corpus file docs/runbooks/breached-passwords.md
#                              builds. Unset in development, passwords are not screened.
HOUSEHOLD_WEB_URL=http://localhost:5173
HOUSEHOLD_ALLOWED_ORIGINS=
HOUSEHOLD_TRUSTED_PROXIES=
HOUSEHOLD_SMTP_URL=smtp://127.0.0.1:1025
HOUSEHOLD_MAIL_FROM=Household <no-reply@household.localhost>
HOUSEHOLD_BREACH_CORPUS=

# What `serve` needs for devices, the second step and the providers (item 9);
# docs/runbooks/sign-in-keys-and-providers.md says how to make and rotate each.
#   HOUSEHOLD_TOKEN_KEYS          Ed25519 seeds in base64, comma-separated: the first signs devices'
#                                 access tokens, and each verifies them. Required outside
#                                 development, which defaults to a published key.
#   HOUSEHOLD_MFA_KEYS            32-byte keys in base64, comma-separated: the first seals the
#                                 second step's secrets and keys its recovery codes. Required outside
#                                 development, which defaults to a published key.
#   HOUSEHOLD_MIN_MOBILE_VERSION  the oldest mobile app served, a version such as 1.6.0; older ones
#                                 are told to update. Unset, every version is served.
#   HOUSEHOLD_MIN_WEB_VERSION     the oldest web client served, alike. Unset, every version is served.
#   HOUSEHOLD_OAUTH_REDIRECT_URIS the redirect URIs a provider may send a person back to,
#                                 comma-separated, each matched exactly.
#   HOUSEHOLD_GOOGLE_CLIENT_ID and HOUSEHOLD_GOOGLE_CLIENT_SECRET: Google, set together or not at all.
#   HOUSEHOLD_APPLE_CLIENT_ID, HOUSEHOLD_APPLE_TEAM_ID, HOUSEHOLD_APPLE_KEY_ID and
#   HOUSEHOLD_APPLE_PRIVATE_KEY, the .p8 key's PEM: Apple, set together or not at all.
HOUSEHOLD_TOKEN_KEYS=
HOUSEHOLD_MFA_KEYS=
HOUSEHOLD_MIN_MOBILE_VERSION=
HOUSEHOLD_MIN_WEB_VERSION=
HOUSEHOLD_OAUTH_REDIRECT_URIS=

# PowerSync (item 13, ADR 0014), which `pnpm run up:sync` starts once `pnpm run db:setup` has made its
# role, its publication and its storage. Bootstrap sets the replication role's password from the first,
# and prepares the bucket storage the second names, a database of its own; outside development the
# first is required and the second may be left unset, the storage then kept on a cluster of its own.
# The third is where a client reaches PowerSync, which its sync credentials name: https outside
# development, and required there. PowerSync fetches the keys it verifies a client's token with from
# the API at http://host.docker.internal:8080/api/v1/sync/jwks (deploy/powersync/powersync.yaml): on
# Linux, where the container does not reach the host's loopback, serve the API where it does, as with
# HOUSEHOLD_HTTP_ADDR=0.0.0.0:8080 on a machine no one else reaches.
HOUSEHOLD_REPLICATION_DATABASE_URL=postgres://household_powersync:household_powersync@127.0.0.1:5432/household?sslmode=disable
HOUSEHOLD_POWERSYNC_STORAGE_URL=postgres://household_powersync_storage:household_powersync_storage@127.0.0.1:5432/powersync_storage?sslmode=disable
HOUSEHOLD_POWERSYNC_URL=http://127.0.0.1:8081

# Files (item 14, ADR 0015). The object store's URL carries its credentials and names its bucket,
# http(s)://ACCESS_KEY:SECRET@host:port/bucket?region=…; outside development it is required, reached
# over https, and never with the compose store's published secret. Development defaults to the compose
# store and its `household` bucket, which the server makes when it starts. The public URL is the scheme
# and host clients reach the store at, which the links the API pre-signs name, when that is not where
# the server reaches it. The converter is the sidecar `pnpm run up:convert` builds and starts (required
# outside development). Uploads are read to the directory named, the system's temporary one when
# unset, for as long as the timeout. `serve` also reads the meter role's connection string above: the
# files workers and the usage sample read across households with it.
HOUSEHOLD_OBJECT_STORE_URL=http://household:household-local-only@127.0.0.1:9000/household
HOUSEHOLD_OBJECT_STORE_PUBLIC_URL=
HOUSEHOLD_CONVERTER_URL=http://127.0.0.1:3100
HOUSEHOLD_UPLOAD_DIR=
HOUSEHOLD_UPLOAD_TIMEOUT=15m

# Notifications (item 15, ADR 0016, docs/runbooks/notifications.md).
#   HOUSEHOLD_NOTIFY_KEYS        32-byte keys in base64, comma-separated: the first seals the token an
#                                invitation's or a graduation's email carries while it waits to be
#                                sent, and each opens it. Required outside development, which
#                                defaults to a published key.
#   HOUSEHOLD_VAPID_KEY          a P-256 private key, 32 bytes in base64url, which signs every Web
#                                Push; GET /push/vapid-key serves its public half. Required outside
#                                development, which defaults to a published key.
#   HOUSEHOLD_PUSH_HOSTS         push services, comma-separated DNS names of two labels or more, a
#                                browser's subscription may name, or a subdomain of, beyond the
#                                known ones.
#   HOUSEHOLD_EXPO_PUSH_URL      Expo's push service, https outside development; Expo's own by default.
#   HOUSEHOLD_EXPO_ACCESS_TOKEN  the access token Expo's push service asks for, when the project
#                                requires one.
HOUSEHOLD_NOTIFY_KEYS=
HOUSEHOLD_VAPID_KEY=
HOUSEHOLD_PUSH_HOSTS=
HOUSEHOLD_EXPO_PUSH_URL=
HOUSEHOLD_EXPO_ACCESS_TOKEN=

# Billing (item 19, ADR 0020, docs/runbooks/billing.md).
#   HOUSEHOLD_STRIPE_SECRET_KEY       Stripe's API key (sk_… or a restricted rk_…), which the server
#                                     asks Stripe with.
#   HOUSEHOLD_STRIPE_PUBLISHABLE_KEY  the key (pk_…) a client's payment form is made with.
#   HOUSEHOLD_STRIPE_WEBHOOK_SECRET   the secret (whsec_…) Stripe signs POST /webhooks/stripe with.
#                                     All three are required outside development; development sets
#                                     all three, Stripe's test-mode ones, or none, when billing
#                                     takes no payment and answers 503 where it would ask Stripe. A
#                                     live key is production's alone, and a test key never
#                                     production's.
#   HOUSEHOLD_STRIPE_AUTOMATIC_TAX    true has Stripe compute each invoice's tax; false by default.
#   HOUSEHOLD_BILLING_PRICES          the plans, JSON on one line: each currency's year, month and
#                                     block, each {"amount_minor": …, "price": "price_…"}, the Stripe
#                                     price that charges it. EUR is required among them; a household
#                                     whose base currency has none is charged EUR's. Unset, PRD 04
#                                     §1's EUR and GBP figures are shown and no payment is taken.
HOUSEHOLD_STRIPE_SECRET_KEY=
HOUSEHOLD_STRIPE_PUBLISHABLE_KEY=
HOUSEHOLD_STRIPE_WEBHOOK_SECRET=
HOUSEHOLD_STRIPE_AUTOMATIC_TAX=
HOUSEHOLD_BILLING_PRICES=

# Where the Go tests reach the object store, with no bucket: each test makes one of its own. This
# default matches the compose service above; CI sets it for its own service container. The
# converter's real-sidecar test runs when HOUSEHOLD_TEST_CONVERTER_URL names a running converter, and
# the test of what billing's Stripe processor sends when HOUSEHOLD_TEST_STRIPE_URL names Stripe's
# mock server, which `pnpm run up:stripe` starts at http://127.0.0.1:12111, or at the port
# HOUSEHOLD_STRIPE_MOCK_PORT names.
HOUSEHOLD_TEST_OBJECT_STORE_URL=http://household:household-local-only@127.0.0.1:9000
HOUSEHOLD_TEST_CONVERTER_URL=
HOUSEHOLD_TEST_STRIPE_URL=
