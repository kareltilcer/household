{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The library's core and its Node replica, and the conformance suite, which runs on Node: its
    // PowerSync clients (@powersync/node), its database reads and the API it starts. The web replica
    // (web/) and the React Native one (native/) are typechecked against their own platforms' types,
    // and the suite's browser smoke test (conformance/web/) against the DOM's.
    "types": ["node"]
  },
  "include": ["src", "conformance"],
  "exclude": ["conformance/web"]
}
