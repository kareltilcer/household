{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.js"],
  "tasks": {
    // `gen` also serves as the transit task below: typecheck, lint and test depend on
    // `^gen`, so their hashes cover the files of the workspace packages they import. The
    // chain has to recurse, or only direct dependencies count, and an edit two packages
    // down would replay a cached pass.
    "gen": {
      "dependsOn": ["^gen"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["gen", "^gen"]
    },
    "lint": {
      "dependsOn": ["gen", "^gen"]
    },
    "test": {
      "dependsOn": ["gen", "^gen"]
    },
    // The workspace guards read files outside tooling/ (docker-compose.yml, the CI
    // workflow, every package's manifest and tsconfig), none of which are in this task's
    // hash. A cached result would pass a guard over files it never re-read.
    "@household/tooling#test": {
      "dependsOn": ["gen", "^gen"],
      "cache": false
    }
  }
}
