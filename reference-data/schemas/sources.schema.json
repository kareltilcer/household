{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The sources reference data cites",
  "description": "Every field of every record names one of these (PL-10). A source is a published document, by its URL, or a document in this repository, by its path; a test checks the path exists. The loader refuses a field that names a source not listed here, and a test refuses a source nothing names.",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "$schema": { "type": "string" },
    "sources": {
      "type": "object",
      "propertyNames": { "$ref": "defs.schema.json#/$defs/sourceId" },
      "additionalProperties": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "$ref": "defs.schema.json#/$defs/text" },
          "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
          "path": { "type": "string", "pattern": "^[a-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9._-]+)*$" },
          "note": { "$ref": "defs.schema.json#/$defs/text" }
        },
        "oneOf": [{ "required": ["url"] }, { "required": ["path"] }],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
