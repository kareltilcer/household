  "care_notes": {
    "value": {
      "en": "Pinch out the side shoots of cordon varieties and water at the base, evenly: wet leaves invite blight, and uneven watering blossom end rot.",
      "cs": "U tyčkových odrůd vylamujte zálistky a zalévejte ke kořenům a pravidelně: mokré listy lákají plíseň a nepravidelná zálivka způsobuje suchou hnilobu špiček plodů.",
      "sk": "Pri kolíkových odrodách vylamujte zálistky a polievajte ku koreňom a pravidelne: mokré listy lákajú pleseň a nepravidelná zálievka spôsobuje suchú hnilobu plodov.",
      "de": "Bei Stabtomaten die Seitentriebe ausgeizen und gleichmäßig am Fuß gießen: Nasse Blätter fördern die Krautfäule, unregelmäßiges Gießen die Blütenendfäule.",
      "pl": "U odmian palikowych usuwaj pędy boczne i podlewaj równomiernie przy korzeniach: mokre liście sprzyjają zarazie, a nierówne podlewanie suchej zgniliźnie wierzchołkowej."
    },
    "source": "rhs-grow-your-own",
    "drafted": true
  },
  "varieties": [
    {
      "key": "black_krim",
      "name": { "value": "Black Krim", "source": "eu-variety-catalogue", "drafted": true },
      "note": {
