{
  "name": "@household/icons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./web/index.ts",
    "./native": "./native/index.ts"
  },
  "scripts": {
    "vendor": "node scripts/vendor.ts",
